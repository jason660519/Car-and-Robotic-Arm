---
import { Image } from 'astro:assets';
import { asset } from '../lib/images';
import modules from '../data/modules.json';
import guide from '../data/assembly-guide.json';
import { href, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const zh = locale === 'zh';
const tr = t(locale);

const stepCount = guide.sections.reduce((n, s) => n + s.steps.length, 0);
const photoCount = new Set(modules.flatMap((m) => m.images)).size;
const heroImage = asset('assets/assembly/021_RobotCar_With_RoboticArm_Combined.jpg');

const hardware = zh
  ? [
      ['主控', 'Raspberry Pi 5'],
      ['驅動板', '有方機器人 NeZha 總線驅動板（I2C 0x40）'],
      ['底盤', '大聖多形態小車（ABS），N20 馬達 ×4'],
      ['電池', 'HXS 18650 11.1V 1200mAh'],
    ]
  : [
      ['Controller', 'Raspberry Pi 5'],
      ['Motor driver', 'YOURFUN NeZha bus driver board (I2C 0x40)'],
      ['Chassis', 'Dasheng multi-form car (ABS), 4× N20 motors'],
      ['Battery', 'HXS 18650 11.1V 1200mAh'],
    ];

const cards = zh
  ? [
      {
        icon: '🧩',
        title: '零件庫存',
        desc: `${modules.length} 個模組、${photoCount} 張實體照片，含規格、接線與程式範例。`,
        path: 'inventory',
      },
      {
        icon: '🔧',
        title: '組裝指南',
        desc: `${guide.sections.length} 個章節、${stepCount} 個步驟，逐頁對照原廠說明書。`,
        path: 'assembly-guide',
      },
    ]
  : [
      {
        icon: '🧩',
        title: 'My Inventory and Tools',
        desc: `${modules.length} modules and ${photoCount} photos, with specs, wiring and code samples.`,
        path: 'inventory',
      },
      {
        icon: '🔧',
        title: 'Assembly Guide',
        desc: `${guide.sections.length} sections, ${stepCount} steps, page-by-page against the vendor manual.`,
        path: 'assembly-guide',
      },
    ];

const warnings = zh
  ? [
      '驅動板需 12V 供電，正負極接反會燒板。',
      '驅動板的 5V 餵給 Pi 時，絕對不可同時接 Pi 的 USB-C —— 原廠手冊明文禁止雙電源。',
      'I2C 速率不得超過 200kHz。Pi 預設 100kHz，不要調 i2c_arm_baudrate。',
      '馬達的 2 孔接頭插進 4 孔編碼器接口會燒板。',
      '第一次跑馬達請把車架空。',
    ]
  : [
      'The driver board needs 12V. Reversed polarity destroys it.',
      'When the board feeds 5V to the Pi, never also plug in the Pi USB-C — the vendor manual forbids dual supplies.',
      'I2C must stay under 200kHz. The Pi defaults to 100kHz; do not raise i2c_arm_baudrate.',
      'Plugging a 2-pin motor lead into the 4-pin encoder port will destroy the board.',
      'Lift the wheels off the ground before the first motor run.',
    ];

const actions = zh
  ? [
      { label: '先看零件庫存', href: href(locale, 'inventory'), kind: 'primary' },
      { label: '看組裝指南', href: href(locale, 'assembly-guide'), kind: 'secondary' },
      {
        label: 'GitHub Repo',
        href: 'https://github.com/jason660519/Car-and-Robotic-Arm',
        kind: 'ghost',
      },
    ]
  : [
      { label: 'Browse Inventory', href: href(locale, 'inventory'), kind: 'primary' },
      { label: 'See Assembly Guide', href: href(locale, 'assembly-guide'), kind: 'secondary' },
      {
        label: 'GitHub Repo',
        href: 'https://github.com/jason660519/Car-and-Robotic-Arm',
        kind: 'ghost',
      },
    ];

const quickFacts = zh
  ? [
      { label: '收錄模組', value: `${modules.length}` },
      { label: '實拍照片', value: `${photoCount}` },
      { label: '組裝步驟', value: `${stepCount}` },
    ]
  : [
      { label: 'Modules tracked', value: `${modules.length}` },
      { label: 'Real photos', value: `${photoCount}` },
      { label: 'Assembly steps', value: `${stepCount}` },
    ];

const statusCards = zh
  ? [
      {
        title: 'I2C 通訊已驗證',
        body: 'Raspberry Pi 5 已成功在位址 0x40 偵測到 NeZha 驅動板，重設與 LED 控制都可正常運作。',
      },
      {
        title: '四輪馬達對應完成',
        body: 'M1 到 M4 的實際輪位與正反方向都已測過，程式中的馬達映射與反向設定已校正。',
      },
      {
        title: '第一次地面行駛通過',
        body: '差速前進、後退、轉向與原地旋轉都完成驗證，也做過一次低速地面前進測試。',
      },
      {
        title: '機械臂仍在調整',
        body: '因部件損壞與相容性因素，機械臂部分目前保留彈性，整體仍以 Smart Car + Robotic 概念持續推進。',
      },
    ]
  : [
      {
        title: 'I2C communication verified',
        body: 'The Raspberry Pi 5 successfully detected the NeZha board at address 0x40, including reset and LED checks.',
      },
      {
        title: 'Wheel mapping confirmed',
        body: 'All four motor ports were matched to the real wheel positions, and the direction fixes are already written back into code.',
      },
      {
        title: 'First ground drive passed',
        body: 'Forward, backward, turning, and spin tests all worked, followed by a short low-speed run on the floor.',
      },
      {
        title: 'Robotic arm remains flexible',
        body: 'Because of damaged parts and compatibility tradeoffs, the arm portion is still evolving while the smart car platform keeps moving forward.',
      },
    ];

const audienceNotes = zh
  ? [
      '有真實接線、實拍照片與測試結果，不只是概念圖。',
      '把零件、文件、驗證腳本與網站整理在同一個 repo，比較適合追進度也方便重現。',
      '保留專案調整與失敗紀錄，讓使用者看得出目前進度與下一步方向。',
    ]
  : [
      'Built around real wiring notes, real photos, and verified test results rather than concept-only documentation.',
      'Keeps parts, docs, verification scripts, and the project site in one repo so it is easier to follow and reproduce.',
      'Shows the project honestly as it evolves, including constraints, tradeoffs, and the next steps.',
    ];
---

<main class="home">
  <section class="home-hero">
    <div class="home-hero__copy">
      <p class="home-eyebrow">{tr('home.eyebrow')}</p>
      <h1>{tr('home.title')}</h1>
      <p class="home-lede">{tr('home.lede')}</p>
      <p class="home-note">{tr('project.note')}</p>

      <div class="home-actions">
        {
          actions.map((action) => (
            <a
              class:list={['home-action', `is-${action.kind}`]}
              href={action.href}
              target={action.href.startsWith('http') ? '_blank' : undefined}
              rel={action.href.startsWith('http') ? 'noreferrer' : undefined}
            >
              {action.label}
            </a>
          ))
        }
      </div>

      <div class="home-facts">
        {quickFacts.map((fact) => (
          <div class="home-fact">
            <strong>{fact.value}</strong>
            <span>{fact.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="home-hero__media">
      <Image
        src={heroImage}
        alt={zh ? 'Smart car 與 robotic arm 實拍照片' : 'Photo of the smart car and robotic arm build'}
        widths={[480, 720, 960]}
        sizes="(max-width: 900px) 100vw, 44vw"
        priority
      />
    </div>
  </section>

  <section class="home-cards">
    {
      cards.map((c) => (
        <a class="home-card" href={href(locale, c.path)}>
          <span class="home-card__icon">{c.icon}</span>
          <h2>{c.title}</h2>
          <p>{c.desc}</p>
        </a>
      ))
    }
  </section>

  <section class="home-status">
    <div class="home-section-heading">
      <p class="home-kicker">{zh ? 'Current Status' : 'Current Status'}</p>
      <h2>{zh ? '現在這個專案做到哪裡？' : 'What is already working?'}</h2>
      <p>
        {zh
          ? '這裡先給第一次來訪的使用者一個快速答案：目前已完成哪些硬體驗證、哪些部分還在調整。'
          : 'A quick summary for first-time visitors: what has already been verified in hardware, and what is still evolving.'}
      </p>
    </div>
    <div class="home-status-grid">
      {statusCards.map((card) => (
        <article class="home-status-card">
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="home-value">
    <div class="home-section-heading">
      <p class="home-kicker">{zh ? 'Why This Repo' : 'Why This Repo'}</p>
      <h2>{zh ? '一般使用者來這裡能看到什麼？' : 'Why might someone want to follow this repo?'}</h2>
    </div>
    <ul class="home-value-list">
      {audienceNotes.map((note) => <li>{note}</li>)}
    </ul>
  </section>

  <section class="home-split">
    <div>
      <h2>{zh ? '硬體組成' : 'Hardware'}</h2>
      <table class="home-table">
        <tbody>
          {
            hardware.map(([k, v]) => (
              <tr>
                <td>{k}</td>
                <td>{v}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div>
      <h2>{zh ? '安全注意事項' : 'Safety'}</h2>
      <ul class="home-warnings">
        {warnings.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  </section>
</main>

<style>
  .home {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 1.5rem 1rem;
  }
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: 2rem;
    align-items: center;
    padding: 2rem 0 3rem;
  }
  .home-hero__copy {
    min-width: 0;
  }
  .home-eyebrow {
    color: var(--accent-cyan);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .home-hero h1 {
    margin: 0.6rem 0 1rem;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.15;
    background: linear-gradient(120deg, var(--text-primary), var(--accent-cyan));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .home-lede {
    max-width: 62ch;
    color: var(--text-secondary);
    font-size: 1.05rem;
  }
  .home-note {
    max-width: 72ch;
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .home-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .home-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    text-decoration: none;
    transition: var(--transition-smooth);
  }
  .home-action:hover {
    transform: translateY(-2px);
  }
  .home-action.is-primary {
    background: var(--accent-blue);
    color: #fff;
    border-color: transparent;
  }
  .home-action.is-secondary {
    background: var(--bg-card);
  }
  .home-action.is-ghost {
    color: var(--text-secondary);
  }
  .home-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .home-fact {
    padding: 0.9rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
  }
  .home-fact strong {
    display: block;
    font-size: 1.35rem;
    line-height: 1.1;
  }
  .home-fact span {
    color: var(--text-secondary);
    font-size: 0.88rem;
  }
  .home-hero__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    box-shadow: var(--shadow-glow);
  }
  .home-hero__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .home-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .home-card {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition: var(--transition-smooth);
  }
  .home-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-glow);
    box-shadow: var(--shadow-glow);
    transform: translateY(-3px);
  }
  .home-card__icon {
    font-size: 1.8rem;
  }
  .home-card h2 {
    margin: 0.5rem 0 0.4rem;
    font-size: 1.15rem;
  }
  .home-card p {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }
  .home-split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
    margin-top: 3.5rem;
  }
  .home-status,
  .home-value {
    margin-top: 3.5rem;
  }
  .home-section-heading {
    max-width: 70ch;
    margin-bottom: 1.25rem;
  }
  .home-section-heading h2 {
    margin-bottom: 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .home-section-heading p {
    color: var(--text-secondary);
  }
  .home-kicker {
    margin-bottom: 0.45rem;
    color: var(--accent-cyan);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .home-status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .home-status-card {
    padding: 1.2rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
  }
  .home-status-card h3 {
    margin-bottom: 0.5rem;
    font-size: 1.02rem;
  }
  .home-status-card p,
  .home-value-list {
    color: var(--text-secondary);
    font-size: 0.94rem;
  }
  .home-value-list {
    padding-left: 1.1rem;
  }
  .home-value-list li {
    margin-bottom: 0.65rem;
  }
  .home-split h2 {
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }
  .home-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .home-table td {
    padding: 0.6rem 0.5rem;
    border-bottom: 1px solid var(--border-color);
    vertical-align: top;
  }
  .home-table td:first-child {
    width: 32%;
    color: var(--text-secondary);
  }
  .home-warnings {
    padding-left: 1.1rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }
  .home-warnings li {
    margin-bottom: 0.6rem;
  }
  .home-warnings li::marker {
    color: var(--accent-rose);
  }
  @media (max-width: 900px) {
    .home-hero {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .home {
      padding-inline: 1rem;
    }
    .home-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
